# Local development (python manage.py runserver). Copy to .env.
# manage.py uses backend.settings.development (backend.settings.test for `manage.py test`).
SECRET_KEY=change-me-secret-key
DEBUG=True
DJANGO_LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Without DATABASE_URL, SQLite (db.sqlite3) is used.
# DATABASE_URL=postgres://fanfiction:fanfiction@localhost:5432/fanfiction
REDIS_URL=redis://localhost:6379/0
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
SERVER_EMAIL=server@localhost
DEFAULT_FROM_EMAIL=no-reply@localhost
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@localhost
